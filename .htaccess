# Включаем механизм перезаписи URL на сервере,
# если mod_rewrite доступен.
RewriteEngine On

# Originals, preview manifests and locks are served only through authorized controllers.
RewriteRule ^storage/image-processor/ - [F,L]

# Если файл или папка существуют физически —
# Apache обслуживает их напрямую.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Все остальные запросы передаются главному index.php.
RewriteRule ^ index.php [L]
